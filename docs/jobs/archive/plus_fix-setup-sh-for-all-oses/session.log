{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0171o12zwJkkF3cMPV1NHDuV","type":"tool_result","content":"     1\t#!/bin/bash\n     2\t\n     3\tset -e\n     4\t\n     5\techo \"Cloning solyto/selfhosted...\"\n     6\tgit clone --depth 1 https://github.com/solyto/selfhosted.git solyto\n     7\tcd solyto\n     8\trm -f LICENSE README.md setup.sh\n     9\tmkdir -p storage\n    10\tmkdir -p storage/app/public storage/framework/{cache,sessions,views} storage/logs bootstrap/cache\n    11\tchown -R www-data:www-data storage/\n    12\t\n    13\techo \"\"\n    14\techo \"Configure domains and email for TLS certificates:\"\n    15\tread -rp \"  API domain   (e.g. api.yourdomain.com): \" API_DOMAIN < /dev/tty\n    16\tread -rp \"  App domain   (e.g. app.yourdomain.com): \" APP_DOMAIN < /dev/tty\n    17\tread -rp \"  DAV domain   (e.g. dav.yourdomain.com): \" DAV_DOMAIN < /dev/tty\n    18\tread -rp \"  ACME email   (e.g. you@yourdomain.com): \" ACME_EMAIL < /dev/tty\n    19\t\n    20\tsed -i \\\n    21\t    -e \"s|^API_DOMAIN=.*|API_DOMAIN=${API_DOMAIN}|\" \\\n    22\t    -e \"s|^APP_DOMAIN=.*|APP_DOMAIN=${APP_DOMAIN}|\" \\\n    23\t    -e \"s|^DAV_DOMAIN=.*|DAV_DOMAIN=${DAV_DOMAIN}|\" \\\n    24\t    -e \"s|^ACME_EMAIL=.*|ACME_EMAIL=${ACME_EMAIL}|\" \\\n    25\t    .env\n    26\t\n    27\techo \"\"\n    28\t\n    29\tSECRETS_DIR=\"./secrets\"\n    30\tmkdir -p \"$SECRETS_DIR\"\n    31\t\n    32\tgenerate_password() {\n    33\t    openssl rand -base64 24 | tr -d '\\n'\n    34\t}\n    35\t\n    36\twrite_secret() {\n    37\t    local name=\"$1\"\n    38\t    local value=\"$2\"\n    39\t    local file=\"$SECRETS_DIR/$name\"\n    40\t    if [ ! -f \"$file\" ]; then\n    41\t        printf '%s' \"$value\" > \"$file\"\n    42\t        echo \"  created:  secrets/$name\"\n    43\t    else\n    44\t        echo \"  skipped:  secrets/$name (already exists)\"\n    45\t    fi\n    46\t}\n    47\t\n    48\twrite_empty() {\n    49\t    local name=\"$1\"\n    50\t    local file=\"$SECRETS_DIR/$name\"\n    51\t    if [ ! -f \"$file\" ]; then\n    52\t        touch \"$file\"\n    53\t        echo \"  created:  secrets/$name (empty)\"\n    54\t    else\n    55\t        echo \"  skipped:  secrets/$name (already exists)\"\n    56\t    fi\n    57\t}\n    58\t\n    59\techo \"Setting up secrets...\"\n    60\t\n    61\t# Generate shared values so db_user/mariadb_user and db_password/mariadb_password match\n    62\tDB_USER=\"solyto\"\n    63\tDB_PASSWORD=\"$(generate_password)\"\n    64\tDAV_DB_USER=\"solyto_dav\"\n    65\tDAV_DB_PASSWORD=\"$(generate_password)\"\n    66\t\n    67\twrite_secret \"app_key\"               \"base64:$(openssl rand -base64 32 | tr -d '\\n')\"\n    68\twrite_secret \"db_user\"               \"$DB_USER\"\n    69\twrite_secret \"db_password\"           \"$DB_PASSWORD\"\n    70\twrite_secret \"dav_db_user\"           \"$DAV_DB_USER\"\n    71\twrite_secret \"dav_db_password\"       \"$DAV_DB_PASSWORD\"\n    72\twrite_secret \"mariadb_root_password\" \"$(generate_password)\"\n    73\twrite_secret \"postgres_root_password\" \"$(generate_password)\"\n    74\t\n    75\techo \"\"\n    76\techo \"Setting up optional secrets (empty by default)...\"\n    77\t\n    78\twrite_empty \"solyto_bot_webhook_token\"\n    79\twrite_empty \"solyto_bot_telegram_token\"\n    80\twrite_empty \"imgproxy_key\"\n    81\twrite_empty \"imgproxy_salt\"\n    82\twrite_empty \"hardcover_api_key\"\n    83\twrite_empty \"ai_api_key\"\n    84\twrite_empty \"tmdb_access_token\"\n    85\twrite_empty \"mailgun_secret\"\n    86\twrite_empty \"vapid_public_key\"\n    87\twrite_empty \"vapid_private_key\"\n    88\twrite_empty \"bgg_api_key\"\n    89\t\n    90\techo \"\"\n    91\techo \"Done. Run: cd solyto && docker compose up -d\"\n50-### Install script\n51-\n52-```\n53:curl -fsSL \"https://raw.githubusercontent.com/solyto/selfhosted/main/setup.sh?$(date +%s)\" | bash\n54-```\n55-\n56-Run this command to run the install script. It will clone all re