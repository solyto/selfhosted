ue\n    env_file: \".env\"\n    image: solyto/api-php:${SOLYTO_VERSION}\n    user: www-data\n    command: php artisan queue:work --tries=3 --timeout=300\n    depends_on:\n      mariadb:\n        condition: service_healthy\n      postgres:\n        condition: service_healthy\n      redis:\n        condition: service_started\n      api:\n        condition: service_healthy\n    environment:\n      DB_USERNAME_FILE: /run/secrets/db_user\n      DB_PASSWORD_FILE: /run/secrets/db_password\n      DAV_DB_USERNAME_FILE: /run/secrets/dav_db_user\n      DAV_DB_PASSWORD_FILE: /run/secrets/dav_db_password\n      APP_KEY_FILE: /run/secrets/app_key\n      SOLYTO_BOT_WEBHOOK_TOKEN_FILE: /run/secrets/solyto_bot_webhook_token\n      SOLYTO_BOT_TELEGRAM_TOKEN_FILE: /run/secrets/solyto_bot_telegram_token\n      HARDCOVER_API_KEY_FILE: /run/secrets/hardcover_api_key\n      TMDB_ACCESS_TOKEN_FILE: /run/secrets/tmdb_access_token\n      VAPID_PRIVATE_KEY_FILE: /run/secrets/vapid_private_key\n      MAILGUN_SECRET_FILE: /run/secrets/mailgun_secret\n      IMGPROXY_KEY_FILE: /run/secrets/imgproxy_key\n      IMGPROXY_SALT_FILE: /run/secrets/imgproxy_salt\n    volumes:\n      - ./storage/:/var/www/storage/\n      - ./php/queue.php.ini:/usr/local/etc/php/conf.d/solyto-php.ini:ro\n    secrets:\n      - db_user\n      - db_password\n      - dav_db_user\n      - dav_db_password\n      - app_key\n      - solyto_bot_webhook_token\n      - solyto_bot_telegram_token\n      - hardcover_api_key\n      - tmdb_access_token\n      - mailgun_secret\n      - vapid_private_key\n      - imgproxy_key\n      - imgproxy_salt\n    restart: unless-stopped\n    networks:\n      - api\n      - db\n      - public\n\n  app:\n    container_name: ${PROJECT_NAME}-app\n    env_file: '.env'\n    image: solyto/app:${SOLYTO_VERSION}\n    depends_on:\n      nginx:\n        condition: service_healthy\n    labels:\n      - \"traefik.enable=true\"\n      - \"traefik.http.routers.app.rule=Host(`${APP_DOMAIN}`)\"\n      - \"traefik.http.routers.app.entrypoints=websecure\"\n      - \"traefik.http.routers.app.tls.certresolver=letsencrypt\"\n      - \"traefik.http.services.app-svc.loadbalancer.server.port=3000\"\n    restart: unless-stopped\n    networks:\n      - public\n\n  imgproxy:\n    image: darthsim/imgproxy:latest\n    container_name: ${PROJECT_NAME}-imgproxy\n    environment:\n      IMGPROXY_LOCAL_FILESYSTEM_ROOT: /images\n      IMGPROXY_KEY_FILE: /run/secrets/imgproxy_key\n      IMGPROXY_SALT_FILE: /run/secrets/imgproxy_salt\n    volumes:\n      - ./storage/:/images:ro\n    secrets:\n      - imgproxy_key\n      - imgproxy_salt\n    networks:\n      - api\n    restart: unless-stopped\n\n  mariadb:\n    image: mariadb:${MARIADB_VERSION}\n    container_name: ${PROJECT_NAME}-mariadb\n    env_file:\n      - .env\n    environment:\n      MARIADB_DATABASE: ${DB_DATABASE}\n      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/mariadb_root_password\n      MARIADB_USER_FILE: /run/secrets/db_user\n      MARIADB_PASSWORD_FILE: /run/secrets/db_password\n    volumes:\n      - mariadb_data:/var/lib/mysql\n      - /etc/localtime:/etc/localtime:ro\n    secrets:\n      - db_user\n      - db_password\n      - mariadb_root_password\n    networks:\n      - db\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD\", \"healthcheck.sh\", \"--connect\", \"--innodb_initialized\"]\n      interval: 5s\n      timeout: 3s\n      retries: 10\n\n  postgres:\n    image: postgres:${POSTGRES_VERSION}\n    container_name: ${PROJECT_NAME}-postgres\n    env_file:\n      - .env\n    environment:\n      POSTGRES_USER: ${POSTGRES_USER}\n      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_root_password\n    volumes:\n      - pg_data:/var/lib/postgresql/data\n      - /etc/localtime:/etc/localtime:ro\n      - ./init-dav.sh:/docker-entrypoint-initdb.d/init-dav.sh:ro\n    secrets:\n      - postgres_root_password\n      - dav_db_user\n      - dav_db_password\n    networks:\n      - db\n    restart: unless-stopped\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U ${POSTGRES_USER}\"]\n      interval: 5s\n      timeout: 3s\n      retries: 10\n\n  redis:\n    image: redis:${REDIS_VERSION}\n    container_name: ${PROJECT_NAME}-redis\n    volumes:\n      - redis_data:/data\n    networks:\n      - db\n    restart: unless-stopped\n\nvolumes:\n  traefik_acme:\n  mariadb_data:\n  pg_data:\n  redis_data:\n\nnetworks:\n  api:\n    driver: bridge\n    internal: true\n\n  db:\n    driver: bridge\n    internal: true\n\n  public:\n\n\nsecrets:\n  mariadb_root_password:\n    file: ./secrets/mariadb_root_password\n  postgres_root_password:\n    file: ./secrets/postgres_root_password\n  db_user:\n    file: ./secrets/db_user\n  db_password:\n    file: ./secrets/db_password\n  dav_db_user:\n    file: ./secrets/dav_db_user\n  dav_db_password:\n    file: ./secrets/dav_db_password\n  app_key:\n    file: ./secrets/app_key\n  solyto_bot_webhook_token:\n    file: ./secrets/solyto_bot_webhook_token\n  solyto_bot_telegram_token:\n    file: ./secrets/solyto_bot_telegram_token\n  hardcover_api_key:\n    file: ./secrets/hardcover_api_key\n  ai_api_key:\n    file: ./secrets/ai_api_key\n  mailgun_secret:\n    file: ./secrets/mailgun_secret\n  vapid_public_key:\n    file: ./secrets/vapid_public_key\n  vapid_private_key:\n    file: ./secrets/vapid_private_key\n  bgg_api_key:\n    file: ./secrets/bgg_api_key\n  tmdb_access_token:\n    file: ./secrets/tmdb_access_token\n  imgproxy_key:\n    file: ./secrets/imgproxy_key\n  imgproxy_salt:\n    file: ./secrets/imgproxy_salt\n","numLines":354,"startLine":1,"totalLines":354}},"tool_result_meta":[{"id":"toolu_01FmT3CE1bg6aU82TdgTXbo6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X8gYKEw5qZshUDGTThCXfv","type":"tool_result","content":"1\t<p align=\"center\">\n2\t  <img src=\"https://raw.githubusercontent.com/solyto/assets/main/solyto_logo.png\" />\n3\t</p>\n4\t\n5\tsolyto is a free, private, all-in-one personal management app — covering your todos, contacts, calendar, notes, news, music and book library in one place, with one login, and one coherent interface. No annoying AI features, no tracking, no subscriptions, no bullshit. Use it on the web, install it as a PWA, or self-host it entirely on your own infrastructure. Built out of frustration with bloated tools, fragmented self-hosted stacks, and services that keep adding things you never asked for.\n6\t\n7\t# \n8\t\n9\t# selfhosted\n10\t\n11\tYou can use solyto for free at [solyto.app](https://solyto.app). If you want to be fully in control, feel free to selfhost it. This repositories provides all necessary files and setup instructions.\n12\t\n13\t## \n14\t\n15\t## Prerequisites\n16\t\n17\tYou can host solyto on almost anything, be it through a compose stack with locally built images or through a compose stack utilizing our pre-built dockerhub images.\n18\t\n19\t**Software Requirements**\n20\t\n21\tThe only thing your server needs is docker & docker compose. The rest is done inside the containers automatically.\n22\t\n23\t**Hardware Requirements**\n24\t\n25\tSolyto is relatively light in resource usage. You should be able to run it on a Raspberry Pi no problem. Any other VPS, cloud server or root server will be more than fine.\n26\t\n27\t## \n28\t\n29\t## Services\n30\t\n31\t| Service    | Image                   | Description                            |\n32\t| ---------- | ----------------------- | -------------------------------------- |\n33\t| `traefik`  | `traefik`               | Reverse proxy, TLS termination         |\n34\t| `nginx`    | `solyto/api-nginx`      | Web server / reverse proxy for the API |\n35\t| `api`      | `solyto/api-php`        | Laravel PHP-FPM application            |\n36\t| `dav`      | `solyto/api-php`        | WebDAV service (separate PHP config)   |\n37\t| `queue`    | `solyto/api-php`        | Laravel queue worker                   |\n38\t| `app`      | `solyto/app`            | Frontend app                           |\n39\t| `mariadb`  | `mariadb`               | Primary database for the API           |\n40\t| `postgres` | `postgres`              | Database for the DAV service           |\n41\t| `redis`    | `redis`                 | Cache and queue backend                |\n42\t| `imgproxy` | `darthsim/imgproxy` *(optional)* | High-performance image processing. Not required — solyto defaults to local image processing without it. |\n43\t\n44\t## \n45\t\n46\t## Setup\n47\t\n48\tYou have two options regarding setup. Either go through steps manually or run our one-step-install script.\n49\t\n50\t### Install script\n51\t\n52\t```\n53\tcurl -fsSL \"https://raw.githubusercontent.com/solyto/selfhosted/main/setup.sh?$(date +%s)\" | bash\n54\t```\n55\t\n56\tRun this command to run the install script. It will clone all relevant files to solyto/, ask you for your domains and set everything up. After doing this, all you have to do is `cd` into solyto/ and run `make start` or `docker compose up -d`.\n57\t\n58\t> **Note on `storage/` ownership:** the script runs `chown -R 33:33 storage/`, because 33 is the UID/GID of `www-data` inside the containers (it doesn't matter whether your host has a `www-data` user). Changing ownership usually needs root, so run the script as root or pipe it to `sudo bash` instead of `bash`. If you need a different UID/GID, set `SOLYTO_UID` / `SOLYTO_GID` (e.g. `... | sudo SOLYTO_UID=1000 SOLYTO_GID=1000 bash`). To fix ownership by hand later: `sudo chown -R 33:33 solyto/storage`.\n59\t\n60\t### Do things manually\n61\t\n62\t**1. Copy relevant files from this repository to your server**\n63\t\n64\tAll you need is:\n65\t\n66\t- .env\n67\t\n68\t- compose.yml\n69\t\n70\t- init-dav.sh (to initiate the Postgres database)\n71\t\n72\t- Makefile (if you want shortcuts for managing your stack)\n73\t\n74\t**2. Configure your domains**\n75\t\n76\tEdit `.env` and fill in your domains and an email address for Let's Encrypt:\n77\t\n78\t```env\n79\tAPI_DOMAIN=api.yourdomain.com\n80\tAPP_DOMAIN=app.yourdomain.com\n81\tDAV_DOMAIN=dav.yourdomain.com\n82\tACME_EMAIL=you@yourdomain.com\n83\t```\n84\t\n85\t**3. Create secrets**\n86\t\n87\tAll secrets are read from files in `./secrets/`. Create the directory and populate each file:\n88\t\n89\t```\n90\tsecrets/\n91\t├── app_key\n92\t├── db_user\n93\t├── db_password\n94\t├── dav_db_user\n95\t├── dav_db_password\n96\t├── mariadb_user\n97\t├── mariadb_password\n98\t├── mariadb_root_password\n99\t├── postgres_root_password\n100\t├── solyto_bot_webhook_token\n101\t├── solyto_bot_telegram_token\n102\t├── hardcover_api_key\n103\t├── ai_api_key\n104\t├── mailgun_secret\n105\t├── vapid_public_key\n106\t├── vapid_private_key\n107\t├── bgg_api_key\n108\t├── imgproxy_key          # optional, see imgproxy section below\n109\t├── imgproxy_salt         # optional, see imgproxy section below\n110\t└── tmdb_access_token     # optional, see TMDB section below\n111\t```\n112\t\n113\tEach file should contain just the secret value, no trailing newline. Example:\n114\t\n115\t```sh\n116\techo -n \"your-secret-value\" > secrets/db_password\n117\t```\n118\t\n119\t<u>Required vs optional secrets</u>\n120\t\n121\t- To use most of solytos functionality, you need these secrets:\n122\t  \n123\t  - app_key\n124\t  \n125\t  - db_user\n126\t  \n127\t  - db_password\n128\t  \n129\t  - dav_db_user\n130\t  \n131\t  - dav_db_password\n132\t  \n133\t  - mariadb_user\n134\t  \n135\t  - mariadb_password\n136\t  \n137\t  - mariadb_root_password\n138\t  \n139\t  - postgres_root_password\n140\t\n141\t- The rest are optional for certain functionality:\n142\t  \n143\t  - Solyto Bot tokens: if you want Telegram integration (sending notifications to users, pasting links to the bot to add it to the users link library, etc.)\n144\t  \n145\t  - Hardcover API Key: if you want to be able to import books from Hardcover directly\n146\t  \n147\t  - AI API Key (`ai_api_key`): if you want music / book recommendations. Works with OpenAI or any OpenAI-compatible provider (e.g. IONOS AI Model Hub). Set `AI_BASE_URL` and `AI_MODEL` in `.env` to point at your preferred provider. This is the only AI feature solyto has. We have looked at others, but didn't find them to be useful. We are also trying to replace the AI recommendations with something more sophisticated and AI-less.\n148\t  \n149\t  - Mailgun Secret: if you need email functionality\n150\t  \n151\t  - Vapid Keys: if you want to use solyto as a Progressive Web App with Push Notifications\n152\t  \n153\t  - BGG API Key: if you want to import games from boardgamesgeek\n154\t  \n155\t  - imgproxy keys (`imgproxy_key`, `imgproxy_salt`): if you want to use imgproxy for image processing instead of the default local processing. imgproxy is not required — solyto works out of the box without it. If you do want to use it, generate two 64-character hex strings (`openssl rand -hex 32`), write them to the secret files, and set `IMAGE_DRIVER=imgproxy` in `.env`.\n156\t  \n157\t  - TMDB Access Token (`tmdb_access_token`): if you want movie & series release notifications and trailers. Get a free Read Access Token from [themoviedb.org](https://www.themoviedb.org/settings/api) after creating an account.\n158\t\n159\t**4. Configure Dev Requests (optional)**\n160\t\n161\tDev Requests is disabled by default on self-hosted instances. Submissions would stay on your local server and never reach the solyto team, which would be confusing. The feature is therefore hidden from the navigation automatically.\n162\t\n163\tIf you want to use Dev Requests as a local feedback board for your own users, set this in `.env`:\n164\t\n165\t```env\n166\tPUBLIC_DISABLE_DEV_REQUESTS=false\n167\t```\n168\t\n169\t**5. Configure legal links (optional)**\n170\t\n171\tThe legal notice button in the navigation is hidden by default on self-hosted instances. If you want to link your users to your own imprint, privacy policy, or terms of service, set any combination of these in `.env`:\n172\t\n173\t```env\n174\tPUBLIC_LEGAL_NOTICE_URL=https://yourdomain.com/imprint\n175\tPUBLIC_PRIVACY_URL=https://yourdomain.com/privacy\n176\tPUBLIC_TERMS_URL=https://yourdomain.com/terms\n177\t```\n178\t\n179\tOnly the links you set will appear. The button stays hidden if none are set.\n180\t\n181\t**6. Configure mail (optional)**\n182\t\n183\tSet the Mailgun values in `.env` if you want outgoing email:\n184\t\n185\t```env\n186\tMAILGUN_DOMAIN=mg.yourdomain.com\n187\tMAIL_FROM_ADDRESS=hello@yourdomain.com\n188\tMAIL_FROM_NAME=Solyto\n189\t```\n190\t\n191\t**7. Configure security (optional)**\n192\t\n193\tIf you want to change the default security policies, you can do so with these 3 flags:\n194\t\n195\t```env\n196\tPASSWORD_MIN_LENGTH=12\n197\tPASSWORD_UNCOMPROMISED=true\n198\tEMAIL_CONFIRMATION=true\n199\t```\n200\t\n201\t**8. Start**\n202\t\n203\t```sh\n204\tdocker compose up -d\n205\t```\n206\t\n207\t**9. Create first user**\n208\t\n209\t```sh\n210\tdocker exec -it solyto-api so users:create\n211\t```\n212\t\n213\t*Please note: if you changed the project name via `.env`, please do also adjust the container name in this command.*\n214\t\n215\t## Networks\n216\t\n217\tThe compose file uses three networks to limit service exposure:\n218\t\n219\t- `api` — internal only, nginx and PHP talk here\n220\t- `db` — internal only, app services connect to the databases here\n221\t- `public` — externally reachable, for services that need outside connectivity\n222\t\n223\t## Storage\n224\t\n225\tThe `./storage/` directory is mounted into nginx, php, dav, and queue so they all share the same filesystem for uploads and generated files.\n226\t\n227\t## Backups\n228\t\n229\tIf you want to regularly backup your data, there are 3 components to it: the MariaDB database, the Postgres database and your local file storage containing album covers, book covers, etc.\n230\t\n231\tWe recommend using restic to automatically backup to a SFTP storage or server of your choice. Have a look at our example backup script.\n232\t\n233\t```#!/bin/bash\n234\t#!/bin/bash\n235\tset -e\n236\t\n237\tREPO=\"sftp:USER@HOST:data\"\n238\tPASSWORD_FILE=\"/etc/restic/repo.key\"\n239\tSQL_API=\"/tmp/api.sql\"\n240\tSQL_DAV=\"/tmp/dav.sql\"\n241\t\n242\techo \"Dumping MariaDB...\"\n243\tdocker exec db-mariadb mariadb-dump -u root -p\"$(cat /home/db/secrets/mariadb_root_password)\" \\\n244\t  --databases api --add-drop-database --routines --triggers --single-transaction \\\n245\t  > \"$SQL_API\"\n246\techo \"MariaDB done.\"\n247\t\n248\techo \"Dumping PostgreSQL...\"\n249\tdocker exec -e PGPASSWORD=\"$(cat /home/db/secrets/postgres_root_password)\" db-postgres \\\n250\t  pg_dump -U postgres --clean --create --if-exists dav \\\n251\t  > \"$SQL_DAV\"\n252\techo \"PostgreSQL done.\"\n253\t\n254\techo \"Running restic backup...\"\n255\trestic -r \"$REPO\" backup \"$SQL_API\" \"$SQL_DAV\" /home/api/storage \\\n256\t  --exclude=\"/home/api/storage/framework/cache\" \\\n257\t  --exclude=\"/home/api/storage/framework/sessions\" \\\n258\t  --exclude=\"/home/api/storage/framework/views\" \\\n259\t  --password-file \"$PASSWORD_FILE\"\n260\techo \"Backup done.\"\n261\t\n262\techo \"Cleaning up...\"\n263\trm -f \"$SQL_API\" \"$SQL_DAV\"\n264\t\n265\techo \"Pruning old snapshots...\"\n266\trestic -r \"$REPO\" forget --keep-last 7 --prune \\\n267\t  --password-file \"$PASSWORD_FILE\"\n268\t\n269\techo \"All done.\"\n270\t```\n271\t\n272\t## Running with an external reverse proxy\n273\t\n274\tTraefik is included in the stack and handles routing and TLS automatically. If you prefer to use your own reverse proxy (e.g. Caddy), remove the `traefik` service from `compose.yml` and point your proxy at the internal ports directly:\n275\t\n276\t- API: `8080`\n277\t- DAV: `8081`\n278\t- App: `3000`\n279\t\n280\tExample Caddyfile:\n281\t\n282\t```\n283\tapi.yourdomain.com {\n284\t    reverse_proxy localhost:8080\n285\t}\n286\t\n287\tdav.yourdomain.com {\n288\t    reverse_proxy localhost:8081\n289\t}\n290\t\n291\tapp.yourdomain.com {\n292\t    reverse_proxy localhost:3000\n293\t}\n294\t```\n295\t\n296\tIf you use an external reverse proxy, set `TRUSTED_PROXIES` in `.env` to your proxy's IP address. This ensures rate limiting works correctly and clients are identified by their real IP rather than the proxy's IP.\n297\t\n298\t## Updates\n299\t\n300\tIf you run our dockerhub images, just pull the newest image and restart the stack. All necessary migrations will be run automatically.\n301\t\n302\t## Downgrades\n303\t\n304\tWe do not yet have a verifiable downgrade strategy. However, all that needs to be done is to rollback previous Laravel Eloquent migrations. We will be releasing all migrations that need to be rolled back with each Dockerhub image release.\n305\t\n306\tWe are working on an automated procedure for this.\n307\t\n308\t## Support\n309\t\n310\tIf you need any help setting your instance up, let us know. We are happy to help.\n311\t\n312\t[Discord](https://discord.gg/JbNPJHG6)\n313\t\n314\t---\n315\t\n316\t## Licensing\n317\t\n318\tSolyto is licensed under the [GNU Affero General Public License v3.0](https://www.gnu.org/licenses/agpl-3.0.en.html) (AGPL-3.0).\n319\t\n320\tYou are free to use, modify, and self-host this software. If you distribute it or run it as a network service, you must make your source code available under the same license.\n321\t"}]},"parent_tool_use_id":null,"session_id":"f3d69f9c-a2d3-42af-8038-53845031b34c","uuid":"12409244-b2e3-42d3-a943-938ebbbe620d","timestamp":"2026-10-14T20:33:59.583Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/README.md","content":"<p align=\"center\">\n  <img src=\"https://raw.githubusercontent.com/solyto/assets/main/solyto_logo.png\" />\n</p>\n\nsolyto is a free, private, all-in-one personal management app — covering your todos, contacts, calendar, notes, news, music and book library in one place, with one login, and one coherent interface. No annoying AI features, no tracking, no subscriptions, no bullshit. Use it on the web, install it as a PWA, or self-host it entirely on your own infrastructure. Built out of frustration with bloated tools, fragmented self-hosted stacks, and services that keep adding things you never asked for.\n\n# \n\n# selfhosted\n\nYou can use solyto for free at [solyto.app](https://solyto.app). If you want to be fully in control, feel free to selfhost it. This repositories provides all necessary files and setup instructions.\n\n## \n\n## Prerequisites\n\nYou can host solyto on almost anything, be it through a compose stack with locally built images or through a compose stack utilizing our pre-built dockerhub images.\n\n**Software Requirements**\n\nThe only thing your server needs is docker & docker compose. The rest is done inside the containers automatically.\n\n**Hardware Requirements**\n\nSolyto is relatively light in resource usage. You should be able to run it on a Raspberry Pi no problem. Any other VPS, cloud server or root server will be more than fine.\n\n## \n\n## Services\n\n| Service    | Image                   | Description                            |\n| ---------- | ----------------------- | -------------------------------------- |\n| `traefik`  | `traefik`               | Reverse proxy, TLS termination         |\n| `nginx`    | `solyto/api-nginx`      | Web server / reverse proxy for the API |\n| `api`      | `solyto/api-php`        | Laravel PHP-FPM application            |\n| `dav`      | `solyto/api-php`        | WebDAV service (separate PHP config)   |\n| `queue`    | `solyto/api-php`        | Laravel queue worker                   |\n| `app`      | `solyto/app`            | Frontend app                           |\n| `mariadb`  | `mariadb`               | Primary database for the API           |\n| `postgres` | `postgres`              | Database for the DAV service           |\n| `redis`    | `redis`                 | Cache and queue backend                |\n| `imgproxy` | `darthsim/imgproxy` *(optional)* | High-performance image processing. Not required — solyto defaults to local image processing without it. |\n\n## \n\n## Setup\n\nYou have two options regarding setup. Either go through steps manually or run our one-step-install script.\n\n### Install script\n\n```\ncurl -fsSL \"https://raw.githubusercontent.com/solyto/selfhosted/main/setup.sh?$(date +%s)\" | bash\n```\n\nRun this command to run the install script. It will clone all relevant files to solyto/, ask you for your domains and set everything up. After doing this, all you have to do is `cd` into solyto/ and run `make start` or `docker compose up -d`.\n\n> **Note on `storage/` ownership:** the script runs `chown -R 33:33 storage/`, because 33 is the UID/GID of `www-data` inside the containers (it doesn't matter whether your host has a `www-data` user). Changing ownership usually needs root, so run the script as root or pipe it to `sudo bash` instead of `bash`. If you need a different UID/GID, set `SOLYTO_UID` / `SOLYTO_GID` (e.g. `... | sudo SOLYTO_UID=1000 SOLYTO_GID=1000 bash`). To fix ownership by hand later: `sudo chown -R 33:33 solyto/storage`.\n\n### Do things manually\n\n**1. Copy relevant files from this repository to your server**\n\nAll you need is:\n\n- .env\n\n- compose.yml\n\n- init-dav.sh (to initiate the Postgres database)\n\n- Makefile (if you want shortcuts for managing your stack)\n\n**2. Configure your domains**\n\nEdit `.env` and fill in your domains and an email address for Let's Encrypt:\n\n```env\nAPI_DOMAIN=api.yourdomain.com\nAPP_DOMAIN=app.yourdomain.com\nDAV_DOMAIN=dav.yourdomain.com\nACME_EMAIL=you@yourdomain.com\n```\n\n**3. Create secrets**\n\nAll secrets are read from files in `./secrets/`. Create the directory and populate each file:\n\n```\nsecrets/\n├── app_key\n├── db_user\n├── db_password\n├── dav_db_user\n├── dav_db_password\n├── mariadb_user\n├── mariadb_password\n├── mariadb_root_password\n├── postgres_root_password\n├── solyto_bot_webhook_token\n├── solyto_bot_telegram_token\n├── hardcover_api_key\n├── ai_api_key\n├── mailgun_secret\n├── vapid_public_key\n├── vapid_private_key\n├── bgg_api_key\n├── imgproxy_key          # optional, see imgproxy section below\n├── imgproxy_salt         # optional, see imgproxy section below\n└── tmdb_access_token     # optional, see TMDB section below\n```\n\nEach file should contain just the secret value, no trailing newline. Example:\n\n```sh\necho -n \"your-secret-value\" > secrets/db_password\n```\n\n<u>Required vs optional secrets</u>\n\n- To use most of solytos functionality, you need these secrets:\n  \n  - app_key\n  \n  - db_user\n  \n  - db_password\n  \n  - dav_db_user\n  \n  - dav_db_password\n  \n  - mariadb_user\n  \n  - mariadb_password\n  \n  - mariadb_root_password\n  \n  - postgres_root_password\n\n- The rest are optional for certain functionality:\n  \n  - Solyto Bot tokens: if you want Telegram integration (sending notifications to users, pasting links to the bot to add it to the users link library, etc.)\n  \n  - Hardcover API Key: if you want to be able to import books from Hardcover directly\n  \n  - AI API Key (`ai_api_key`): if you want music / book recommendations. Works with OpenAI or any OpenAI-compatible provider (e.g. IONOS AI Model Hub). Set `AI_BASE_URL` and `AI_MODEL` in `.env` to point at your preferred provider. This is the only AI feature solyto has. We have looked at others, but didn't find them to be useful. We are also trying to replace the AI recommendations with something more sophisticated and AI-less.\n  \n  - Mailgun Secret: if you need email functionality\n  \n  - Vapid Keys: if you want to use solyto as a Progressive Web App with Push Notifications\n  \n  - BGG API Key: if you want to import games from boardgamesgeek\n  \n  - imgproxy keys (`imgproxy_key`, `imgproxy_salt`): if you want to use imgproxy for image processing instead of the default local processing. imgproxy is not required — solyto works out of the box without it. If you do want to use it, generate two 64-character hex strings (`openssl rand -hex 32`), write them to the secret files, and set `IMAGE_DRIVER=imgproxy` in `.env`.\n  \n  - TMDB Access Token (`tmdb_access_token`): if you want movie & series release notifications and trailers. Get a free Read Access Token from [themoviedb.org](https://www.themoviedb.org/settings/api) after creating an account.\n\n**4. Configure Dev Requests (optional)**\n\nDev Requests is disabled by default on self-hosted instances. Submissions would stay on your local server and never reach the solyto team, which would be confusing. The feature is therefore hidden from the navigation automatically.\n\nIf you want to use Dev Requests as a local feedback board for your own users, set this in `.env`:\n\n```env\nPUBLIC_DISABLE_DEV_REQUESTS=false\n```\n\n**5. Configure legal links (optional)**\n\nThe legal notice button in the navigation is hidden by default on self-hosted instances. If you want to link your users to your own imprint, privacy policy, or terms of service, set any combination of these in `.env`:\n\n```env\nPUBLIC_LEGAL_NOTICE_URL=https://yourdomain.com/imprint\nPUBLIC_PRIVACY_URL=https://yourdomain.com/privacy\nPUBLIC_TERMS_URL=https://yourdomain.com/terms\n```\n\nOnly the links you set will appear. The button stays hidden if none are set.\n\n**6. Configure mail (optional)**\n\nSet the Mailgun values in `.env` if you want outgoing email:\n\n```env\nMAILGUN_DOMAIN=mg.yourdomain.com\nMAIL_FROM_ADDRESS=hello@yourdomain.com\nMAIL_FROM_NAME=Solyto\n```\n\n**7. Configure security (optional)**\n\nIf you want to change the default security policies, you can do so with these 3 flags:\n\n```env\nPASSWORD_MIN_LENGTH=12\nPASSWORD_UNCOMPROMISED=true\nEMAIL_CONFIRMATION=true\n```\n\n**8. Start**\n\n```sh\ndocker compose up -d\n```\n\n**9. Create first user**\n\n```sh\ndocker exec -it solyto-api so users:create\n```\n\n*Please note: if you changed the project name via `.env`, please do also adjust the container name in this command.*\n\n## Networks\n\nThe compose file uses three networks to limit service exposure:\n\n- `api` — internal only, nginx and PHP talk here\n- `db` — internal only, app services connect to the databases here\n- `public` — externally reachable, for services that need outside connectivity\n\n## Storage\n\nThe `./storage/` directory is mounted into nginx, php, dav, and queue so they all share the same filesystem for uploads and generated files.\n\n## Backups\n\nIf you want to regularly backup your data, there are 3 components to it: the MariaDB database, the Postgres database and your local file storage containing album covers, book covers, etc.\n\nWe recommend using restic to automatically backup to a SFTP storage or server of your choice. Have a look at our example backup script.\n\n```#!/bin/bash\n#!/bin/bash\nset -e\n\nREPO=\"sftp:USER@HOST:data\"\nPASSWORD_FILE=\"/etc/restic/repo.key\"\nSQL_API=\"/tmp/api.sql\"\nSQL_DAV=\"/tmp/dav.sql\"\n\necho \"Dumping MariaDB...\"\ndocker exec db-mariadb mariadb-dump -u root -p\"$(cat /home/db/secrets/mariadb_root_password)\" \\\n  --databases api --add-drop-database --routines --triggers --single-transaction \\\n  > \"$SQL_API\"\necho \"MariaDB done.\"\n\necho \"Dumping PostgreSQL...\"\ndocker exec -e PGPASSWORD=\"$(cat /home/db/secrets/postgres_root_password)\" db-postgres \\\n  pg_dump -U postgres --clean --create --if-exists dav \\\n  > \"$SQL_DAV\"\necho \"PostgreSQL done.\"\n\necho \"Running restic backup...\"\nrestic -r \"$REPO\" backup \"$SQL_API\" \"$SQL_DAV\" /home/api/storage \\\n  --exclude=\"/home/api/storage/framework/cache\" \\\n  --exclude=\"/home/api/storage/framework/sessions\" \\\n  --exclude=\"/home/api/storage/framework/views\" \\\n  --password-file \"$PASSWORD_FILE\"\necho \"Backup done.\"\n\necho \"Cleaning up...\"\nrm -f \"$SQL_API\" \"$SQL_DAV\"\n\necho \"Pruning old snapshots...\"\nrestic -r \"$REPO\" forget --keep-last 7 --prune \\\n  --password-file \"$PASSWORD_FILE\"\n\necho \"All done.\"\n```\n\n## Running with an external reverse proxy\n\nTraefik is included in the stack and handles routing and TLS automatically. If you prefer to use your own reverse proxy (e.g. Caddy), remove the `traefik` service from `compose.yml` and point your proxy at the internal ports directly:\n\n- API: `8080`\n- DAV: `8081`\n- App: `3000`\n\nExample Caddyfile:\n\n```\napi.yourdomain.com {\n    reverse_proxy localhost:8080\n}\n\ndav.yourdomain.com {\n    reverse_proxy localhost:8081\n}\n\napp.yourdomain.com {\n    reverse_proxy localhost:3000\n}\n```\n\nIf you use an external reverse proxy, set `TRUSTED_PROXIES` in `.env` to your proxy's IP address. This ensures rate limiting works correctly and clients are identified by their real IP rather than the proxy's IP.\n\n## Updates\n\nIf you run our dockerhub images, just pull the newest image and restart the stack. All necessary migrations will be run automatically.\n\n## Downgrades\n\nWe do not yet have a verifiable downgrade strategy. However, all that needs to be done is to rollback previous Laravel Eloquent migrations. We will be releasing all migrations that need to be rolled back with each Dockerhub image release.\n\nWe are working on an automated procedure for this.\n\n## Support\n\nIf you need any help setting your instance up, let us know. We are happy to help.\n\n[Discord](https://discord.gg/JbNPJHG6)\n\n---\n\n## Licensing\n\nSolyto is licensed under the [GNU Affero General Public License v3.0](https://www.gnu.org/licenses/agpl-3.0.en.html) (AGPL-3.0).\n\nYou are free to use, modify, and self-host this software. If you distribute it or run it as a network service, you must make your source code available under the same license.\n","numLines":321,"startLine":1,"totalLines":321}},"tool_result_meta":[{"id":"toolu_01X8gYKEw5qZshUDGTThCXfv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
